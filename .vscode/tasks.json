{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "install",
			"label": "npm install",
			"cwd": "${workspaceFolder}/backend",
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"type": "shell",
			"label": "backend: npm run dev",
			"command": "npm",
			"args": [
				"--prefix",
				"${workspaceFolder}/backend",
				"run",
				"dev"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}